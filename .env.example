# ---- Public (inlined into the browser bundle; never put secrets here) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: override the Robinhood Chain RPC used in the browser (public RPC is rate-limited).
NEXT_PUBLIC_RHC_RPC_URL=

# ---- Server-only ----
# Intent router (cross-chain leg). Get a JWT from the router's partner dashboard.
ROUTER_JWT=
# Address that receives the protocol's routing fee (integrator fee). Leave empty to quote without a fee.
ROUTER_FEE_RECIPIENT=
# Routing fee in basis points (30 = 0.30%). Max 500.
ROUTER_FEE_BPS=30
# Alchemy key for production-grade RPC reads on Robinhood Chain.
ALCHEMY_API_KEY=
