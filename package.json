{
  "name": "rhmask",
  "version": "0.1.0",
  "private": true,
  "description": "RhMask - the privacy layer for tokenized stocks on Robinhood Chain",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts extension/src cli/src",
    "typecheck": "tsc --noEmit",
    "check:stealth": "node scripts/stealth-check.ts",
    "check": "node scripts/prepush-check.mjs",
    "check:fast": "node scripts/prepush-check.mjs --fast",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:payment": "node scripts/payment-check.ts",
    "check:onchain": "node scripts/onchain-check.ts",
    "build:extension": "node extension/build.mjs",
    "check:keycrypto": "node scripts/keycrypto-check.ts",
    "contracts:build": "node scripts/contracts-build.mjs",
    "contracts:deploy": "node scripts/contracts-deploy.mjs",
    "check:captions": "node scripts/captions-check.mjs",
    "build:cli": "node cli/build.mjs",
    "check:cli": "node scripts/cli-check.ts",
    "contracts:deploy:testnet": "node scripts/contracts-deploy.mjs --network testnet",
    "bridge:testnet": "node scripts/bridge-testnet.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "jsqr": "^1.4.0",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "viem": "^2.55.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/chrome": "^0.2.9",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.3",
    "solc": "^0.8.26",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  }
}
